# Telemetría MikroTik de solo lectura.
# Completar solo después de verificar el equipo y su organización en PostgreSQL.
MIKROTIK_HOST=
MIKROTIK_ORGANIZATION_ID=
MIKROTIK_SSH_PORT=22
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=

# Alternativa a la contraseña. Use una clave asociada a un usuario limitado.
MIKROTIK_PRIVATE_KEY_PATH=

# Obligatorio al configurar host: huella SHA-256 hexadecimal verificada por otro canal.
MIKROTIK_SSH_HOST_HASH=

# Puerto HTTP del backend COMECORE.
PORT=3001

# Telemetría MikroTik de solo lectura.
# El host detectado por Ethernet directo en esta Mac se incluye como referencia.
MIKROTIK_HOST=fe80::2ec8:1bff:fecb:af83%en4
MIKROTIK_SSH_PORT=22
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=

# Alternativa a la contraseña. Use una clave asociada a un usuario limitado.
MIKROTIK_PRIVATE_KEY_PATH=

# Opcional: hash SHA-256 entregado por ssh2 para fijar la identidad del equipo.
MIKROTIK_SSH_HOST_HASH=

# Puerto HTTP del backend COMECORE.
PORT=3000

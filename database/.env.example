# Futuro backend; configurar solo en el servidor. Nunca usar NEXT_PUBLIC_DATABASE_URL.
# Las credenciales reales de desarrollo se generan en database/.env, ignorado por Git.
DATABASE_URL=postgresql://comecore_runtime:CONFIGURAR_SECRETO@127.0.0.1:5432/comecore?sslmode=disable
# En producción: conexión privada y TLS con verificación del certificado del servidor.

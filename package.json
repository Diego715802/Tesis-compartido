{
  "name": "erp-isp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=@erp/frontend",
    "dev:backend": "npm run start:dev --workspace=@erp/backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=@erp/backend",
    "test:database": "node scripts/test-customer-database.cjs",
    "test:erp-database": "node scripts/test-erp-database.cjs",
    "test:customer-flow": "node scripts/test-customer-contract-flow.mjs",
    "test:demo-customer": "node scripts/test-demo-customer.mjs",
    "db:seed-demo": "node scripts/seed-demo-customer.mjs",
    "test:security": "node scripts/test-auth-security.mjs",
    "test:network-boundary": "node scripts/test-network-boundary.mjs",
    "test:http-boundaries": "node scripts/test-http-boundaries.mjs",
    "db:model": "node scripts/generate-database-model.cjs",
    "db:model:obsidian": "node scripts/document-database-model.cjs",
    "db:diagram": "node scripts/serve-database-model.cjs"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
